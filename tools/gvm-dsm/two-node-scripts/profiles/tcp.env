# RVCK TCP DSM profile for the current lab wiring.
# This profile currently uses the MCX512A Ethernet addresses as an ordinary
# TCP data plane.  Change the two addresses before using it without the cards.
TRANSPORT="tcp"
EXPECTED_KERNEL="${DSM_EXPECTED_KERNEL_OVERRIDE:-6.6.158-rvck-dsm-tcp-dev}"

NODE0_DATA_IP="192.168.100.1"
NODE1_DATA_IP="192.168.100.2"
NODE0_MGMT_IP="10.0.2.168"
NODE1_MGMT_IP="10.0.0.159"
NODE1_SSH="ubuntu@${NODE1_MGMT_IP}"
CLUSTER_IPLIST="${NODE0_DATA_IP} ${NODE1_DATA_IP}"
DSM_CLUSTER_IPLIST="${CLUSTER_IPLIST}"
IO_ROUTER_BACKEND="tcp"
RDMA_DEVICE=""

QEMU_PATH="${HOME}/gvm-riscv-work/qemu-10.1.2-rvck-rdma-router/bin/qemu-system-riscv64"
QEMU_DATA_DIR="${HOME}/gvm-riscv-work/qemu-10.1.2-rvck-rdma-router/share/qemu"
KERNEL_PATH="${HOME}/riscv/vmlinuz-6.17.0-35-generic"
INITRD_PATH="${HOME}/riscv/initrd.img-6.17.0-35-generic"
SEED_PATH="${DSM_SEED_PATH_OVERRIDE:-${HOME}/riscv/seed.img}"
BASE_ROOTFS="${DSM_BASE_ROOTFS_OVERRIDE:-${HOME}/riscv/ubuntu-24.04-server-cloudimg-riscv64-dsm-base.img}"
BASE_ROOTFS_SHA256="${DSM_BASE_ROOTFS_SHA256_OVERRIDE:-55d50c7b2405aced62c56aa711f60cbae773642edd6aa3f585136975e718c915}"
RUN_ROOTFS_DIR="${HOME}/riscv/dsm-runs"
