# RVCK TCP DSM profile for the current lab wiring.
# This profile currently uses the MCX512A Ethernet addresses as an ordinary
# TCP data plane.  Change the two addresses before using it without the cards.
TRANSPORT="tcp"
EXPECTED_KERNEL="6.6.158-rvck-dsm-tcp-dev"

NODE0_DATA_IP="192.168.100.1"
NODE1_DATA_IP="192.168.100.2"
NODE1_SSH="ubuntu@192.168.100.2"
CLUSTER_IPLIST="${NODE0_DATA_IP} ${NODE1_DATA_IP}"
RDMA_DEVICE=""

QEMU_PATH="${HOME}/gvm-riscv-work/qemu-10.1.2-dsm/build/qemu-system-riscv64"
KERNEL_PATH="${HOME}/riscv/vmlinuz-6.17.0-35-generic"
INITRD_PATH="${HOME}/riscv/initrd.img-6.17.0-35-generic"
SEED_PATH="${HOME}/riscv/seed.img"
BASE_ROOTFS="${HOME}/riscv/ubuntu-24.04-server-cloudimg-riscv64.img"
BASE_ROOTFS_SHA256="55d50c7b2405aced62c56aa711f60cbae773642edd6aa3f585136975e718c915"
RUN_ROOTFS_DIR="${HOME}/riscv/dsm-runs"
